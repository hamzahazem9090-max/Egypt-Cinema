server {
    listen ${PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # --- ترشيد أمني على كل الاستجابات ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' https: blob:; connect-src 'self' https:; frame-src *; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- لوحة الادارة: محمية بكلمة مرور (يحددها المدير في متغيرات البيئة) ---
    location = /dashboard.html {
        auth_basic "Egypt Cinema — لوحة الادارة";
        auth_basic_user_file /etc/nginx/htpasswd;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # HTML أساسي: لا كاش (دائما تحقق) حتى يصلك آخر تحديث فورا
    location = /index.html {
        expires -1;
    }

    # JS/CSS: تحقق دائم (ETag يرجع 304، لا كرّن 7 أيام مرة أخرى)
    location ~* \.(css|js)$ {
        expires 1h;
    }

    location ~* \.(png|jpg|jpeg|svg|ico|webp)$ {
        expires 7d;
    }

    # --- وسيط بحث Top Cinema للروبوتات WP REST (يتجاوز CORS ويخفي اتصال المصدر) ---
    location /search/ {
        proxy_pass https://topcinema.io/;
        proxy_set_header Host topcinema.io;
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36";
        proxy_ssl_server_name on;
        proxy_ssl_name topcinema.io;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # تمرير ترويسات الترقيم الخاصة بـ WordPress (لصفحة التصفح)
        proxy_pass_header X-WP-Total;
        proxy_pass_header X-WP-TotalPages;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}